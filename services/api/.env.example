PORT=8080
LOG_LEVEL=debug

# Supabase:
# Prefer Session pooler on port 5432 when your network can reach it.
# If port 5432 is blocked, use Transaction pooler on port 6543 and keep
# default_query_exec_mode=simple_protocol for pgx compatibility.
# Add sslmode=require if it is not already present.
# Never commit your real password.
DATABASE_URL=postgres://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
